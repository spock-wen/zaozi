/* 全局唯一一份数据； GlyphCatalog 只读它。 */
public let GLYPH_ROWS: ArrayList<GlyphRow> = buildGlyphRows()

public class GlyphCatalog {
    /* 全部行（CSV 顺序）。 */
    public static func all(): ArrayList<GlyphRow> {
        return GLYPH_ROWS
    }

    public static func count(): Int64 {
        return GLYPH_ROWS.size
    }

    public static func byIndex(index: Int64): GlyphRow {
        return GLYPH_ROWS[index]
    }

    /* 一个字的全部阶段，按 order 升序（缺的阶段本来就不在表里）。 */
    public static func ofChar(id: String): ArrayList<GlyphRow> {
        let out = ArrayList<GlyphRow>()
        var i: Int64 = 0
        while (i < GLYPH_ROWS.size) {
            if (GLYPH_ROWS[i].id == id) {
                out.add(GLYPH_ROWS[i])
            }
            i = i + 1
        }
        var a: Int64 = 1
        while (a < out.size) {
            let cur = out[a]
            var b: Int64 = a - 1
            while (b >= 0 && out[b].order > cur.order) {
                out[b + 1] = out[b]
                b = b - 1
            }
            out[b + 1] = cur
            a = a + 1
        }
        return out
    }

    /* 字表（CSV 里首次出现的顺序），27 字。 */
    public static func charIds(): ArrayList<String> {
        let out = ArrayList<String>()
        var i: Int64 = 0
        while (i < GLYPH_ROWS.size) {
            let id = GLYPH_ROWS[i].id
            var seen: Bool = false
            var j: Int64 = 0
            while (j < out.size) {
                if (out[j] == id) {
                    seen = true
                }
                j = j + 1
            }
            if (!seen) {
                out.add(id)
            }
            i = i + 1
        }
        return out
    }

    /* asset → 行下标，找不到返回 -1。 */
    public static func indexOfAsset(asset: String): Int64 {
        var i: Int64 = 0
        while (i < GLYPH_ROWS.size) {
            if (GLYPH_ROWS[i].asset == asset) {
                return i
            }
            i = i + 1
        }
        return -1
    }
}
