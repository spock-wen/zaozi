import std.collection.ArrayList

/* 一个字的一个阶段。字段与 CSV 列一一对应：
   CSV 的 char 列在本文件里叫 glyph（char 与关键字冲突）。 */
public class GlyphRow {
    public let id: String
    public let glyph: String
    public let trad: String
    public let method: String
    public let order: Int64
    public let stage: String
    public let stageLabel: String
    public let format: String
    public let csvPath: String
    public let asset: String
    public let sha1: String
    public let creditNote: String
    public let sourceLabel: String
    public let license: String

    public init(
        id: String,
        glyph: String,
        trad: String,
        method: String,
        order: Int64,
        stage: String,
        stageLabel: String,
        format: String,
        csvPath: String,
        asset: String,
        sha1: String,
        creditNote: String,
        sourceLabel: String,
        license: String
    ) {
        this.id = id
        this.glyph = glyph
        this.trad = trad
        this.method = method
        this.order = order
        this.stage = stage
        this.stageLabel = stageLabel
        this.format = format
        this.csvPath = csvPath
        this.asset = asset
        this.sha1 = sha1
        this.creditNote = creditNote
        this.sourceLabel = sourceLabel
        this.license = license
    }
}

