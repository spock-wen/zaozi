{
  "schema_version": "1",
  "_说明": "一年里程碑卡池：10 张卡（春 3、夏 3、秋 2、冬 2）+ 1 次冬夜。卡上数值是内容样例，按 GAMEPLAY §3 的幅度（一个选项动 1–3 维，每次 4–12）写；落字「水」的数值照 §2.4 的例子。trace 表示选这一边后卡上出现的迹，target 是这条迹能刻成的字，tally_text 是事签文案。",
  "cards": [
    { "id": "C01", "season": "spring", "speaker": "族长",
      "text": "春汛退了，河滩露出一大片软泥。族长想趁早全族下滩抢种。",
      "left":  { "label": "全族下滩抢种", "delta": { "food": 8, "outsider": -4 } },
      "right": { "label": "先把堤补上", "delta": { "food": -4, "memory": 6 } },
      "drops": [] },
    { "id": "C02", "season": "spring", "speaker": "采集的妇人",
      "text": "一夜大雨，北坡塌下去一块。她说坡下露出了怪东西，没人敢过去看。",
      "left":  { "label": "绕开北坡，别招惹", "delta": { "faith": 4, "memory": -4 } },
      "right": { "label": "下去看个究竟", "delta": { "food": -4, "memory": 6 },
                 "trace": { "target": "本", "tally_text": "坡上的土被雨冲开，那截老干脚下露出一团盘结的须，顺着往深处挖，越挖越粗，最粗的一股一直扎进石缝里" } },
      "drops": [] },
    { "id": "C03", "season": "spring", "speaker": "巫",
      "text": "播种前，巫要拿一头小牲口祭河。",
      "left":  { "label": "照巫说的祭", "delta": { "faith": 8, "food": -6 } },
      "right": { "label": "牲口留着开春用", "delta": { "faith": -6, "food": 4 } },
      "drops": [] },
    { "id": "C04", "season": "summer", "speaker": "东岸的使者",
      "text": "东岸的猎手趁水浅过了河，在我们的猎场上下了套。",
      "left":  { "label": "把他们赶回去", "delta": { "outsider": -8, "food": 4 } },
      "right": { "label": "猎场让出一半", "delta": { "outsider": 6, "food": -6 } },
      "drops": [ { "char": "水", "label": "以河为界", "delta": { "outsider": 4, "food": -4 }, "note": "GAMEPLAY §2.4 的落字例子" } ] },
    { "id": "C05", "season": "summer", "speaker": "北山来的赶路者",
      "text": "一个北山来的赶路者走到村口，热得走不动了。",
      "left":  { "label": "留他到天凉再走", "delta": { "outsider": 6, "food": -4 },
                 "trace": { "target": "休", "tally_text": "晌午正热，赶路的背抵着一截老干，头顶叶子遮着太阳，一直待到天色转凉" } },
      "right": { "label": "催他赶紧上路", "delta": { "outsider": -4, "faith": 4 } },
      "drops": [] },
    { "id": "C06", "season": "summer", "speaker": "守堤的老汉",
      "text": "夜里河水涨过了第二道土坎，再涨就要漫进粟地。",
      "left":  { "label": "全族搬上高坡", "delta": { "food": -8, "memory": 4 } },
      "right": { "label": "守着土坎不走", "delta": { "food": 4, "faith": -6 } },
      "drops": [] },
    { "id": "C07", "season": "autumn", "speaker": "族里最壮的汉子",
      "text": "满满一车粟陷进了泥里，几个后生推不动。",
      "left":  { "label": "让他一个人来撬", "delta": { "food": 6, "faith": -4 },
                 "trace": { "target": "力", "tally_text": "他把耒插进车轮底下的泥里，弯腰往上撬，胳膊上的筋一条条鼓起来，车轮一点点出了泥" } },
      "right": { "label": "卸下一半再推", "delta": { "food": -4, "memory": 4 } },
      "drops": [] },
    { "id": "C08", "season": "autumn", "speaker": "北山的人",
      "text": "北山的人赶着两头牛来，想拿牛骨换我们的粟种。",
      "left":  { "label": "换", "delta": { "food": -6, "outsider": 4 }, "bones": 1 },
      "right": { "label": "粟种不给外人", "delta": { "outsider": -4, "food": 4 } },
      "drops": [] },
    { "id": "C09", "season": "winter", "speaker": "巫",
      "text": "冬祭到了。巫要一片骨片去占来年的收成。",
      "left":  { "label": "给他一片", "delta": { "faith": 8 }, "bones": -1 },
      "right": { "label": "骨片要留着记事", "delta": { "faith": -6, "memory": 4 }, "hidden_marker": "witch_hostility",
                 "trace": { "target": "月", "tally_text": "冬祭那夜你守在河边，天上只剩弯弯一牙，又细又亮，照在冰面上像一把镰" } },
      "drops": [] },
    { "id": "C10", "season": "winter", "speaker": "族长",
      "text": "雪下了三天，族长要清点过冬的粮，看够不够撑到开春。",
      "left":  { "label": "按户分下去", "delta": { "food": -4, "faith": 4 } },
      "right": { "label": "先紧着猎手", "delta": { "food": -4, "outsider": 4 } },
      "drops": [ { "char": "火", "label": "围着一堆柴同吃同睡", "delta": { "faith": 4, "food": -6 }, "note": "落字样例，数值待玩法稿确认" } ] }
  ],
  "winter_night": { "after": "last_winter_card", "note": "冬季最后一张卡之后进入冬夜；冬季两张卡的先后按种子洗牌，所以不绑定某一张卡" }
}
